<% content_for :title, "#{@hall.name} - データ分析" %>
<% content_for :head do %>
<link rel="stylesheet" href="/stylesheets/data_analysis.css">
<% end %>

<% content_for :header_title, "#{@hall.name} · データ分析" %>
<% content_for :header_actions do %>
    <%= link_to "← 日付一覧", hall_path(@hall), class: "header-link" %>
    <%= link_to "傾向調査", hall_trend_analysis_path(@hall), class: "header-link" %>
    <%= link_to "🗂️ マップ管理", hall_maps_path(@hall), class: "header-link" %>
<% end %>

<div class="container">
    <% if @perf_metrics %>
    <div class="perf-banner">
        <span class="perf-banner__item">⏱ <strong><%= @perf_metrics[:total_ms] %>ms</strong></span>
        <span class="perf-banner__sep">·</span>
        <span class="perf-banner__item">📦 <%= number_with_delimiter(@perf_metrics[:total_records]) %>件</span>
        <span class="perf-banner__sep">·</span>
        <span class="perf-banner__item">期間 <%= @perf_metrics[:analysis_days] %>日</span>
        <span class="perf-banner__sep">·</span>
        <span class="perf-banner__item">機種 <%= @perf_metrics[:machine_kinds] %></span>
        <span class="perf-banner__detail" title="load <%= @perf_metrics[:load_ms] %>ms / matrices <%= @perf_metrics[:matrices_ms] %>ms">⋯</span>
    </div>
    <% end %>

    <!-- 期間選択フォーム -->
    <div class="filter-panel">
        <%= form_with url: hall_data_analysis_path(@hall), method: :get, local: true do |form| %>
        <div class="filter-controls">
            <label>分析期間:</label>
            <input type="date" name="start_date" value="<%= @start_date %>" />
            <span>〜</span>
            <input type="date" name="end_date" value="<%= @end_date %>" />
            <button type="submit" class="btn-success">🔍 更新</button>
            <span style="color: #666; font-size: 13px;">
                （<%= (@end_date - @start_date).to_i + 1 %>日間）
            </span>
        </div>
        <% end %>
    </div>

    <!-- カレンダーマトリクス -->
    <%= render 'calendar_matrix' %>

    <!-- 末尾日×末尾番台マトリクス -->
    <%= render 'last_digit_machine_matrix' %>

    <!-- 末尾日×曜日マトリクス -->
    <%= render 'last_digit_weekday_matrix' %>

    <!-- 第〇×曜日マトリクス -->
    <%= render 'week_weekday_matrix' %>

    <!-- 日付×機種名マトリクス -->
    <%= render 'machine_date_matrix' %>
</div>
