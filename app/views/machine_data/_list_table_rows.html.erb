<!-- データ行 -->
<% @machine_data.each do |data| %>
<tr class="<%= @data_exists ? '' : 'no-data-row' %>">
    <td class="cell-center cell-bold">
        <%= link_to data.machine_number, hall_machine_history_path(@hall, data.machine_number), class: "machine-number-link" %>
    </td>
    <td class="machine-name-cell"><%= data.machine_name %></td>
    <td class="cell-right"><%= @data_exists ? number_with_delimiter(data.game_count) : '-' %></td>
    <td class="cell-right <%= @data_exists && data.difference_count != 0 ? (data.difference_count > 0 ? 'value-positive' : 'value-negative') : '' %>">
        <%= @data_exists ? number_with_delimiter(data.difference_count) : '-' %>
    </td>
    <% if @show_bb %><td class="cell-center"><%= @data_exists ? data.bb_count : '-' %></td><% end %>
    <% if @show_rb %><td class="cell-center"><%= @data_exists ? data.rb_count : '-' %></td><% end %>
    <% if @show_art %><td class="cell-center"><%= @data_exists ? data.art_count : '-' %></td><% end %>

    <!-- 過去差枚のセル -->
    <% if @show_difference && @display_days.any? %>
    <% @display_days.each do |days| %>
    <%
      diff = @diff_days[days][data.machine_number]
      rank = @diff_ranks[days][data.machine_number]
      best_rank = @diff_best_ranks[days][data.machine_number]
      cell_class = if best_rank && best_rank <= 2
                     case best_rank
                     when 1 then 'best-1'
                     when 2 then 'best-2'
                     else ''
                     end
                   elsif rank && rank <= 5
                     case rank
                     when 1 then 'worst-1'
                     when 2 then 'worst-2'
                     when 3 then 'worst-3'
                     when 4 then 'worst-4'
                     when 5 then 'worst-5'
                     else ''
                     end
                   else
                     ''
                   end
    %>
    <td class="cell-right <%= cell_class %>">
        <%= diff ? number_with_delimiter(diff) : '-' %>
    </td>
    <% end %>
    <% end %>

    <!-- 過去回転数のセル -->
    <% if @show_games && @display_days.any? %>
    <% @display_days.each do |days| %>
    <%
      game_count = @game_count_days[days][data.machine_number]
      rank = @game_count_ranks[days][data.machine_number]
      cell_class = case rank
                  when 1 then 'worst-1'
                  when 2 then 'worst-2'
                  when 3 then 'worst-3'
                  when 4 then 'worst-4'
                  else ''
                  end
    %>
    <td class="cell-right <%= cell_class %>">
        <%= game_count ? number_with_delimiter(game_count) : '-' %>
    </td>
    <% end %>
    <% end %>

    <!-- メモ入力 -->
    <td class="memo-cell">
        <input type="text" data-machine-number="<%= data.machine_number %>" data-date="<%= @date %>" data-original-value="<%= data.machine_memo %>" class="memo-input" value="<%= data.machine_memo %>">
    </td>
</tr>
<% end %>
