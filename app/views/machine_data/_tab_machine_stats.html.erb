<div class="machine-stats-container">
    <% if !@data_exists %>
    <div class="alert alert-danger">
        ⚠️ この日のデータが存在しないため、機種別集計を表示できません。
    </div>
    <% elsif @machine_stats.empty? %>
    <p style="text-align: center; color: #666; padding: 20px;">機種データがありません</p>
    <% else %>
    <%
      stats_5_plus = @machine_stats.select { |s| s[:total_machines] >= 5 }
      stats_3_to_4 = @machine_stats.select { |s| s[:total_machines] >= 3 && s[:total_machines] <= 4 }
      stats_1_to_2 = @machine_stats.select { |s| s[:total_machines] <= 2 }

      [stats_5_plus, stats_3_to_4, stats_1_to_2].each do |group|
        group.sort_by! { |s| -s[:avg_diff] }
        group.each_with_index { |s, i| s[:group_rank] = i + 1 }
      end
    %>

    <% [
      { title: '5台以上の機種', stats: stats_5_plus, header_class: 'rank-section__header--green', section_id: 'stats-5plus', collapsed: false },
      { title: '3〜4台の機種',   stats: stats_3_to_4, header_class: 'rank-section__header--blue',  section_id: 'stats-3to4', collapsed: true },
      { title: '2台以下の機種',   stats: stats_1_to_2, header_class: 'rank-section__header--amber', section_id: 'stats-1to2', collapsed: true }
    ].each do |section| %>
    <% next if section[:stats].empty? %>

    <section class="rank-section <%= 'collapsed' if section[:collapsed] %>" id="<%= section[:section_id] %>">
        <header class="rank-section__header <%= section[:header_class] %>" onclick="this.parentElement.classList.toggle('collapsed')">
            <span>📊 <%= section[:title] %> (<%= section[:stats].length %>機種)</span>
            <span class="rank-section__toggle">▼</span>
        </header>

        <div class="rank-section__body">
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>順位</th>
                            <th>機種名</th>
                            <th>台数</th>
                            <th>平均差枚</th>
                            <th>総差枚</th>
                            <th>平均G数</th>
                            <th>勝率</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% section[:stats].each do |stat| %>
                        <tr>
                            <td class="rank-row__rank-cell">
                                <% if stat[:group_rank] == 1 %>
                                    <span class="rank-medal">🥇</span>
                                <% elsif stat[:group_rank] == 2 %>
                                    <span class="rank-medal">🥈</span>
                                <% elsif stat[:group_rank] == 3 %>
                                    <span class="rank-medal">🥉</span>
                                <% else %>
                                    <%= stat[:group_rank] %>
                                <% end %>
                            </td>
                            <td class="cell-bold"><%= stat[:machine_name] %></td>
                            <td class="cell-center cell-bold"><%= stat[:total_machines] %>台</td>
                            <td class="cell-right <%= stat[:avg_diff] >= 0 ? 'value-positive' : 'value-negative' %>">
                                <%= number_with_delimiter(stat[:avg_diff]) %>
                            </td>
                            <td class="cell-right <%= stat[:total_diff] >= 0 ? 'value-positive' : 'value-negative' %>">
                                <%= number_with_delimiter(stat[:total_diff]) %>
                            </td>
                            <td class="cell-right"><%= number_with_delimiter(stat[:avg_games]) %></td>
                            <td class="cell-center <%= stat[:win_rate] >= 50 ? 'value-positive' : 'value-negative' %>">
                                <%= stat[:win_rate] %>% (<%= stat[:plus_machines] %>/<%= stat[:total_machines] %>)
                            </td>
                        </tr>
                        <% end %>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
    <% end %>

    <div class="overall-summary">
        <h4>📊 集計情報</h4>
        <ul>
            <li><strong>機種数:</strong> <%= @machine_stats.length %>機種</li>
            <li><strong>総台数:</strong> <%= @machine_stats.sum { |s| s[:total_machines] } %>台</li>
            <% total_machines_all = @machine_stats.sum { |s| s[:total_machines] } %>
            <% overall_avg = total_machines_all > 0 ? @machine_stats.sum { |s| s[:avg_diff] * s[:total_machines] } / total_machines_all.to_f : 0 %>
            <% overall_total = @machine_stats.sum { |s| s[:total_diff] } %>
            <li><strong>全体平均差枚:</strong>
                <span class="<%= overall_avg >= 0 ? 'value-positive' : 'value-negative' %>"><%= number_with_delimiter(overall_avg.round) %></span>
            </li>
            <li><strong>全体総差枚:</strong>
                <span class="<%= overall_total >= 0 ? 'value-positive' : 'value-negative' %>"><%= number_with_delimiter(overall_total) %></span>
            </li>
        </ul>
    </div>
    <% end %>
</div>
