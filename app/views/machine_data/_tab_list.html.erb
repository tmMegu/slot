<!-- フィルター（過去データ設定を含む） -->
<%= render 'filter_controls', panel_id: 'filter-content-list' %>

<!-- 一覧ツールバー: サマリー(左) + メモ更新(右) を1行に -->
<div class="list-toolbar">
    <% if @data_exists && @filtered_summary %>
    <div class="list-summary">
        <span class="list-summary__item">
            <span class="list-summary__label">台数</span>
            <strong><%= @filtered_summary[:count] %></strong>
        </span>
        <span class="list-summary__item">
            <span class="list-summary__label">平均G数</span>
            <strong><%= number_with_delimiter(@filtered_summary[:avg_games]) %></strong>
        </span>
        <span class="list-summary__item">
            <span class="list-summary__label">平均差枚</span>
            <strong class="<%= @filtered_summary[:avg_diff] >= 0 ? 'value-positive' : 'value-negative' %>">
                <%= @filtered_summary[:avg_diff] >= 0 ? '+' : '' %><%= number_with_delimiter(@filtered_summary[:avg_diff]) %>
            </strong>
        </span>
        <span class="list-summary__item">
            <span class="list-summary__label">勝率</span>
            <strong class="<%= @filtered_summary[:win_rate] >= 40 ? 'value-positive' : 'value-negative' %>">
                <%= @filtered_summary[:win_rate] %>%
            </strong>
            <span class="list-summary__sub">(<%= @filtered_summary[:plus_machines] %>/<%= @filtered_summary[:count] %>)</span>
        </span>
    </div>
    <% else %>
    <span></span>
    <% end %>
    <button type="button" class="btn btn-success btn-small" onclick="saveMemos()">💾 メモ更新</button>
</div>

<!-- データテーブル -->
<div class="table-wrapper list-table-wrapper">
    <% if @machine_data.empty? %>
    <p style="text-align: center; color: #666; padding: 20px;">検索条件に合致するデータがありません</p>
    <% else %>
    <table class="data-table">
        <thead>
            <tr>
                <th class="sortable <%= 'sort-' + @sort_order if @sort_by == 'machine_number' %>" onclick="sort('machine_number')">台番号</th>
                <th class="sortable machine-name-header <%= 'sort-' + @sort_order if @sort_by == 'machine_name' %>" onclick="sort('machine_name')">機種名</th>
                <th class="sortable <%= 'sort-' + @sort_order if @sort_by == 'game_count' %>" onclick="sort('game_count')">G数</th>
                <th class="sortable <%= 'sort-' + @sort_order if @sort_by == 'difference_count' %>" onclick="sort('difference_count')">差枚</th>
                <% if @show_bb %><th class="sortable <%= 'sort-' + @sort_order if @sort_by == 'bb_count' %>" onclick="sort('bb_count')">BB</th><% end %>
                <% if @show_rb %><th class="sortable <%= 'sort-' + @sort_order if @sort_by == 'rb_count' %>" onclick="sort('rb_count')">RB</th><% end %>
                <% if @show_art %><th class="sortable <%= 'sort-' + @sort_order if @sort_by == 'art_count' %>" onclick="sort('art_count')">ART</th><% end %>

                <% if @show_difference && @display_days.any? %>
                <% @display_days.each do |days| %>
                <th class="sortable <%= 'sort-' + @sort_order if @sort_by == "diff_#{days}" %>" onclick="sort('diff_<%= days %>')">差枚<%= days %></th>
                <% end %>
                <% end %>

                <% if @show_games && @display_days.any? %>
                <% @display_days.each do |days| %>
                <th class="sortable <%= 'sort-' + @sort_order if @sort_by == "game_count_#{days}" %>" onclick="sort('game_count_<%= days %>')">回転<%= days %></th>
                <% end %>
                <% end %>

                <th style="min-width: 100px;">メモ</th>
            </tr>
        </thead>
        <tbody>
            <%= render 'list_table_rows' %>
        </tbody>
    </table>
    <% end %>
</div>
