<%
  panel_id ||= 'filter-content'
%>

<div class="filter-controls collapsible-panel">
  <div class="collapsible-header" onclick="togglePanel('<%= panel_id %>')">
    <h3>🔍 フィルター</h3>
    <span class="collapsible-toggle">▼</span>
  </div>
  <div id="<%= panel_id %>" class="collapsible-content">
    <div class="collapsible-inner">
      <form id="filter-form" method="get">
        <input type="hidden" name="hall_id" value="<%= params[:hall_id] %>">
        <input type="hidden" id="active-tab" name="active_tab" value="<%= params[:active_tab] || 'list' %>">
        <% @display_days.each do |day| %>
        <input type="hidden" name="display_days[]" value="<%= day %>">
        <% end %>

        <!-- 日付 -->
        <div class="fc-section fc-section--date">
          <div class="fc-group">
            <label class="fc-label">📅 日付</label>
            <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
              <input type="date" id="date-input" name="date" value="<%= @date %>" required
                class="fc-input" onchange="changeDate(this.value, <%= params[:hall_id] %>)">
              <% prev_date = @date - 1.day %>
              <% next_date = @date + 1.day %>
              <a href="<%= url_for(action: 'show', hall_id: params[:hall_id], date: prev_date, sort_by: @sort_by, sort_order: @sort_order, display_days: @display_days) %>" class="fc-btn-nav">◀ 前日</a>
              <span style="font-size:12px; color:#555; min-width:105px; text-align:center;"><%= @date.strftime('%Y年%m月%d日') %></span>
              <a href="<%= url_for(action: 'show', hall_id: params[:hall_id], date: next_date, sort_by: @sort_by, sort_order: @sort_order, display_days: @display_days) %>" class="fc-btn-nav">翌日 ▶</a>
              <a href="<%= url_for(action: 'show', hall_id: params[:hall_id], date: Date.today, sort_by: @sort_by, sort_order: @sort_order, display_days: @display_days) %>" class="fc-btn-nav fc-btn-nav--today">📍 今日</a>
            </div>
          </div>
        </div>

        <!-- 機種名・台番号 -->
        <div class="fc-section">
          <div class="fc-grid fc-grid--2col">
            <div class="fc-group">
              <label class="fc-label">機種名</label>
              <select name="filter_machine_name" class="fc-select">
                <option value="">--すべて--</option>
                <% @machine_names.each do |name| %>
                <option value="<%= name %>" <%= 'selected' if @filter_machine_name == name %>><%= name %></option>
                <% end %>
              </select>
            </div>
            <div class="fc-group">
              <label class="fc-label">台番号末尾</label>
              <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                <select name="filter_machine_last_digit" class="fc-select" style="width:80px;">
                  <option value="">--すべて--</option>
                  <% (0..9).each do |digit| %>
                  <option value="<%= digit %>" <%= 'selected' if @filter_machine_last_digit == digit.to_s %>><%= digit %></option>
                  <% end %>
                </select>
                <label class="fc-check-label">
                  <input type="checkbox" name="filter_machine_double_digit" value="1" <%= 'checked' if @filter_machine_double_digit %>>
                  ぞろ目のみ
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- 機種名検索 -->
        <input type="hidden" name="filter_machine_name_operator" id="filter-machine-name-operator" value="<%= @filter_machine_name_operator %>">
        <div class="fc-section">
          <div class="fc-group">
            <label class="fc-label">機種名検索</label>
            <div style="display:flex; gap:6px; align-items:center;">
              <input type="text" id="filter-machine-name-search" name="filter_machine_name_search"
                placeholder="検索ワード" value="<%= @filter_machine_name_search %>" class="fc-input" style="flex:1; min-width:120px;">
              <select id="filter-machine-name-search-type" name="filter_machine_name_search_type" class="fc-select" style="width:90px;">
                <option value="include" <%= 'selected' if @filter_machine_name_search_type == 'include' %>>含む</option>
                <option value="exclude" <%= 'selected' if @filter_machine_name_search_type == 'exclude' %>>含まない</option>
              </select>
            </div>
            <div style="display:flex; gap:6px; flex-wrap:wrap; align-items:center; margin-top:4px;">
              <span style="font-size:11px; color:#666;">プリセット:</span>
              <button type="button" onclick="applyMachineNamePreset('沖 ジャグラー', 'exclude', 'and')" class="fc-btn-preset fc-btn-preset--orange">沖・ジャグラー除外</button>
              <button type="button" onclick="applyMachineNamePreset('', 'include', 'or')" class="fc-btn-preset">解除</button>
            </div>
          </div>
        </div>

        <!-- 数値フィルター -->
        <div class="fc-section">
          <div class="fc-grid fc-grid--3col">
            <div class="fc-group">
              <label class="fc-label">G数</label>
              <div class="fc-range">
                <input type="number" name="filter_game_count_min" placeholder="最小" value="<%= @filter_game_count_min %>" class="fc-input fc-input--num">
                <span class="fc-range-sep">～</span>
                <input type="number" name="filter_game_count_max" placeholder="最大" value="<%= @filter_game_count_max %>" class="fc-input fc-input--num">
              </div>
            </div>
            <div class="fc-group">
              <label class="fc-label">当日差枚</label>
              <div class="fc-range">
                <input type="number" name="filter_difference_min" placeholder="最小" value="<%= @filter_difference_min %>" class="fc-input fc-input--num">
                <span class="fc-range-sep">～</span>
                <input type="number" name="filter_difference_max" placeholder="最大" value="<%= @filter_difference_max %>" class="fc-input fc-input--num">
              </div>
            </div>
            <div class="fc-group">
              <label class="fc-label">BB数</label>
              <div class="fc-range">
                <input type="number" name="filter_bb_count_min" placeholder="最小" value="<%= @filter_bb_count_min %>" class="fc-input fc-input--num">
                <span class="fc-range-sep">～</span>
                <input type="number" name="filter_bb_count_max" placeholder="最大" value="<%= @filter_bb_count_max %>" class="fc-input fc-input--num">
              </div>
            </div>
            <div class="fc-group">
              <label class="fc-label">機種毎台数</label>
              <div class="fc-range">
                <input type="number" name="filter_machine_count_min" placeholder="最小" value="<%= @filter_machine_count_min %>" min="0" class="fc-input fc-input--num">
                <span class="fc-range-sep">～</span>
                <input type="number" name="filter_machine_count_max" placeholder="最大" value="<%= @filter_machine_count_max %>" min="0" class="fc-input fc-input--num">
              </div>
            </div>
          </div>
        </div>

        <!-- 過去N日フィルター -->
        <div class="fc-section">
          <div class="fc-grid fc-grid--2col">
            <div class="fc-group">
              <label class="fc-label">過去N日の差枚</label>
              <div class="fc-range">
                <span class="fc-range-text">過去</span>
                <select name="filter_diff_days" class="fc-select fc-select--days">
                  <option value="">--</option>
                  <% (1..31).each do |days| %>
                  <option value="<%= days %>" <%= 'selected' if @filter_diff_days == days %>><%= days %>日</option>
                  <% end %>
                </select>
                <input type="number" name="filter_diff_value_min" placeholder="最小" value="<%= @filter_diff_value_min %>" class="fc-input fc-input--num">
                <span class="fc-range-sep">～</span>
                <input type="number" name="filter_diff_value_max" placeholder="最大" value="<%= @filter_diff_value_max %>" class="fc-input fc-input--num">
              </div>
            </div>
            <div class="fc-group">
              <label class="fc-label">過去N日の回転数</label>
              <div class="fc-range">
                <span class="fc-range-text">過去</span>
                <select name="filter_game_count_days" class="fc-select fc-select--days">
                  <option value="">--</option>
                  <% (1..31).each do |days| %>
                  <option value="<%= days %>" <%= 'selected' if @filter_game_count_days == days %>><%= days %>日</option>
                  <% end %>
                </select>
                <input type="number" name="filter_game_count_value_min" placeholder="最小" value="<%= @filter_game_count_value_min %>" class="fc-input fc-input--num">
                <span class="fc-range-sep">～</span>
                <input type="number" name="filter_game_count_value_max" placeholder="最大" value="<%= @filter_game_count_value_max %>" class="fc-input fc-input--num">
              </div>
            </div>
            <div class="fc-group">
              <label class="fc-label">過去N日マイナスの台</label>
              <div class="fc-range">
                <span class="fc-range-text">過去</span>
                <select name="filter_past_negative_days" class="fc-select fc-select--days">
                  <option value="">--</option>
                  <% (1..31).each do |days| %>
                  <option value="<%= days %>" <%= 'selected' if params[:filter_past_negative_days].to_i == days %>><%= days %>日</option>
                  <% end %>
                </select>
                <span class="fc-range-text">の差枚合計がマイナス</span>
              </div>
            </div>
            <div class="fc-group">
              <label class="fc-label">マイナスになった日数</label>
              <div class="fc-range">
                <span class="fc-range-text">過去</span>
                <select name="filter_negative_count_days" class="fc-select fc-select--days">
                  <option value="">--</option>
                  <% (1..31).each do |days| %>
                  <option value="<%= days %>" <%= 'selected' if params[:filter_negative_count_days].to_i == days %>><%= days %>日</option>
                  <% end %>
                </select>
                <input type="number" name="filter_negative_count_min" placeholder="最小" value="<%= @filter_negative_count_min %>" class="fc-input fc-input--num">
                <span class="fc-range-sep">～</span>
                <input type="number" name="filter_negative_count_max" placeholder="最大" value="<%= @filter_negative_count_max %>" class="fc-input fc-input--num">
                <span class="fc-range-text">日</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 機種絞り込み -->
        <div class="fc-section">
          <div class="fc-grid fc-grid--2col">
            <div class="fc-group">
              <label class="fc-label fc-label--danger">📉 マイナス台数最多機種</label>
              <div class="fc-range">
                <span class="fc-range-text">過去</span>
                <select name="filter_model_most_negative_days" class="fc-select fc-select--days">
                  <option value="">--なし--</option>
                  <% (1..31).each do |days| %>
                  <option value="<%= days %>" <%= 'selected' if @filter_model_most_negative_days == days %>><%= days %>日</option>
                  <% end %>
                </select>
                <span class="fc-range-text">間</span>
              </div>
            </div>
            <div class="fc-group">
              <label class="fc-label fc-label--purple">📊 総差枚最低機種</label>
              <div class="fc-range">
                <span class="fc-range-text">過去</span>
                <select name="filter_model_worst_diff_days" class="fc-select fc-select--days">
                  <option value="">--なし--</option>
                  <% (1..31).each do |days| %>
                  <option value="<%= days %>" <%= 'selected' if @filter_model_worst_diff_days == days %>><%= days %>日</option>
                  <% end %>
                </select>
                <span class="fc-range-text">間</span>
              </div>
            </div>
          </div>
        </div>

        <!-- ワーストランキング -->
        <div class="fc-section">
          <div class="fc-group">
            <label class="fc-label fc-label--danger">🏆 機種毎ワースト台</label>
            <div class="fc-rank-row">
              <span class="fc-range-text">過去</span>
              <select name="filter_rank_days" class="fc-select fc-select--days">
                <option value="">--</option>
                <% (1..31).each do |days| %>
                <option value="<%= days %>" <%= 'selected' if params[:filter_rank_days].to_i == days %>><%= days %>日</option>
                <% end %>
              </select>
              <span class="fc-range-text">の差枚で絞り込み</span>
              <% [[1,'#ff6b6b'],[2,'#ffb3b3'],[3,'#66cc66'],[4,'#b3e6b3'],[5,'#999']].each do |rank, color| %>
              <label class="fc-check-label" style="color:<%= color %>; font-weight:bold;">
                <input type="checkbox" name="filter_ranks[]" value="<%= rank %>" id="rank-<%= rank %>" <%= 'checked' if params[:filter_ranks]&.include?(rank.to_s) %>>
                ワースト<%= rank %>位
              </label>
              <% end %>
            </div>
          </div>
        </div>

        <!-- ベストランキング -->
        <div class="fc-section">
          <div class="fc-group">
            <label class="fc-label fc-label--gold">⭐ 機種毎ベスト台</label>
            <div class="fc-rank-row">
              <span class="fc-range-text">過去</span>
              <select name="filter_best_rank_days" class="fc-select fc-select--days">
                <option value="">--</option>
                <% (1..31).each do |days| %>
                <option value="<%= days %>" <%= 'selected' if params[:filter_best_rank_days].to_i == days %>><%= days %>日</option>
                <% end %>
              </select>
              <span class="fc-range-text">の差枚で絞り込み</span>
              <% [[1,'#ffd700'],[2,'#ffa500'],[3,'#ff8c00'],[4,'#ffc966'],[5,'#999']].each do |rank, color| %>
              <label class="fc-check-label" style="color:<%= color %>; font-weight:bold;">
                <input type="checkbox" name="filter_best_ranks[]" value="<%= rank %>" id="best-rank-<%= rank %>" <%= 'checked' if params[:filter_best_ranks]&.include?(rank.to_s) %>>
                ベスト<%= rank %>位
              </label>
              <% end %>
            </div>
          </div>
        </div>

        <!-- 表示設定 -->
        <div class="fc-section">
          <div class="fc-group">
            <label class="fc-label fc-label--green">📅 表示する過去データの設定</label>
            <div style="display:flex; gap:12px; flex-wrap:wrap; margin-bottom:8px;">
              <label class="fc-check-label">
                <input type="checkbox" id="show-difference" name="show_difference" value="1" <%= 'checked' if params[:show_difference] != '0' %>>
                過去差枚
              </label>
              <label class="fc-check-label">
                <input type="checkbox" id="show-games" name="show_games" value="1" <%= 'checked' if params[:show_games] == '1' %>>
                過去回転数
              </label>
              <label class="fc-check-label">
                <input type="checkbox" id="show-bb" name="show_bb" value="1" <%= 'checked' if params[:show_bb] == '1' %>>
                BB回数
              </label>
              <label class="fc-check-label">
                <input type="checkbox" id="show-rb" name="show_rb" value="1" <%= 'checked' if params[:show_rb] == '1' %>>
                RB回数
              </label>
              <label class="fc-check-label">
                <input type="checkbox" id="show-art" name="show_art" value="1" <%= 'checked' if params[:show_art] == '1' %>>
                ART回数
              </label>
            </div>
            <label class="fc-label" style="margin-bottom:4px; display:block;">表示する日数</label>
            <div class="fc-days-grid">
              <% (1..31).each do |day| %>
              <label class="fc-check-label">
                <input type="checkbox" id="day-<%= day %>" name="display_days[]" value="<%= day %>" <%= 'checked' if @display_days.include?(day) %>>
                <%= day %>日
              </label>
              <% end %>
            </div>
            <div style="display:flex; gap:6px; flex-wrap:wrap; margin-top:6px;">
              <button type="button" onclick="selectPreset('7-7')" class="fc-btn-preset fc-btn-preset--yellow">7日</button>
              <button type="button" onclick="selectPreset('1-8')" class="fc-btn-preset fc-btn-preset--yellow">週単位（1〜8日）</button>
              <button type="button" onclick="selectPreset('1-31')" class="fc-btn-preset fc-btn-preset--yellow">全期間</button>
              <button type="button" onclick="clearAllDays()" class="fc-btn-preset fc-btn-preset--red">すべて解除</button>
            </div>
          </div>
        </div>

        <!-- ボタン -->
        <div class="fc-section" style="border-bottom:none; padding-top:12px;">
          <div class="filter-buttons">
            <button type="submit" class="btn-apply" style="padding:6px 16px; border-radius:6px;">フィルター適用</button>
            <button type="button" class="btn-reset" onclick="resetFilter()" style="padding:6px 16px; border-radius:6px; white-space:nowrap;">リセット</button>
          </div>
        </div>
      </form>

      <% if params[:filter_machine_name].present? || params[:filter_machine_name_search].present? ||
              params[:filter_game_count_min].present? || params[:filter_game_count_max].present? ||
              params[:filter_difference_min].present? || params[:filter_difference_max].present? ||
              params[:filter_bb_count_min].present? || params[:filter_bb_count_max].present? ||
              params[:filter_diff_days].present? || params[:filter_game_count_days].present? ||
              params[:filter_rank_days].present? || params[:filter_machine_count_min].present? ||
              params[:filter_machine_count_max].present? || params[:filter_model_most_negative_days].present? ||
              params[:filter_model_worst_diff_days].present? %>
      <div class="result-info">
        ✓ フィルター適用済み: <strong><%= @machine_data.length %></strong>台を表示中
      </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  function applyMachineNamePreset(text, type, operator) {
    const searchInput = document.getElementById('filter-machine-name-search');
    const typeSelect = document.getElementById('filter-machine-name-search-type');
    const operatorInput = document.getElementById('filter-machine-name-operator');
    if (searchInput) searchInput.value = text;
    if (typeSelect) typeSelect.value = type;
    if (operatorInput) operatorInput.value = operator;
    document.getElementById('filter-form')?.submit();
  }
</script>
