<% content_for :head do %>
    <link rel="stylesheet" href="/stylesheets/trend_analysis.css">
<% end %>

<% content_for :header_title, "#{@hall.name} · 傾向調査" %>
<% content_for :header_actions do %>
    <%= link_to "← 日付一覧", hall_path(@hall), class: "header-link" %>
    <%= link_to "データ分析", hall_data_analysis_path(@hall), class: "header-link" %>
    <%= link_to "🗂️ マップ管理", hall_maps_path(@hall), class: "header-link" %>
<% end %>

<div class="container">

    <!-- フィルターパネル -->
    <%= render "filter_panel" %>

    <!-- 日付一覧テーブル -->
    <%= render "summary_table" %>
</div>

<script>
    // フィルターのリセット
    function resetFilters() {
        window.location.href = "<%= hall_trend_analysis_path(@hall, reset_filters: 1) %>";
    }

    // 折りたたみパネルの制御
    function togglePanel(panelId) {
        const panel = document.getElementById(panelId);
        const toggle = panel.previousElementSibling.querySelector('.toggle-icon');
        if (panel.style.display === 'none') {
            panel.style.display = 'block';
            toggle.textContent = '▼';
        } else {
            panel.style.display = 'none';
            toggle.textContent = '▶';
        }
    }
</script>
