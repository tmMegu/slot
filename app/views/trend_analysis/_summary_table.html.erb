<% if @daily_summary.empty? %>
<div class="no-data">
    <p>📭 条件に一致するデータがありません</p>
    <p style="font-size: 14px; color: #999;">フィルター条件を変更してお試しください</p>
</div>
<% else %>
<div style="margin-bottom: 10px; color: #666; font-size: 14px;">
    📊 検索結果: <strong><%= @daily_summary.length %></strong>日分のデータ
    <% if @analysis_start_date && @analysis_end_date %>
    （分析期間: <%= @analysis_start_date.strftime('%Y/%m/%d') %> 〜 <%= @analysis_end_date.strftime('%Y/%m/%d') %>）
    <% end %>
</div>

<table class="summary-table">
    <thead>
        <tr>
            <th>日付</th>
            <th>合計差枚</th>
            <th>平均差枚</th>
            <th>平均回転数</th>
            <th>勝率</th>
            <% if @show_top_machines_1 %><th>1位機種</th><% end %>
            <% if @show_top_machines_2 %><th>2位機種</th><% end %>
            <% if @show_top_machines_3 %><th>3位機種</th><% end %>
        </tr>
    </thead>
    <tbody>
        <!-- 合計/平均行を最初に表示 -->
        <% if @daily_summary.length > 1 %>
        <tr style="background-color: #e9ecef; font-weight: bold;">
            <td>📈 合計/平均</td>
            <td class="<%= @daily_summary.sum { |s| s[:total_diff] } >= 0 ? 'positive' : 'negative' %>">
                <%= number_with_delimiter(@daily_summary.sum { |s| s[:total_diff] }) %>
            </td>
            <td class="<%= (@daily_summary.sum { |s| s[:avg_diff] } / @daily_summary.length.to_f).round >= 0 ? 'positive' : 'negative' %>">
                <%= number_with_delimiter((@daily_summary.sum { |s| s[:avg_diff] } / @daily_summary.length.to_f).round) %>
            </td>
            <td><%= number_with_delimiter((@daily_summary.sum { |s| s[:avg_games] } / @daily_summary.length.to_f).round) %></td>
            <td>
                <% avg_win_rate = (@daily_summary.sum { |s| s[:win_rate] } / @daily_summary.length.to_f).round(1) %>
                <span class="<%= avg_win_rate >= 40 ? 'positive' : 'negative' %>">
                    <%= sprintf('%.1f', avg_win_rate) %>%
                </span>
                (<%= @daily_summary.sum { |s| s[:plus_machines] } %>/<%= @daily_summary.sum { |s| s[:machine_count] } %>)
            </td>
            <% if @show_top_machines_1 %><td style="color: #999;">-</td><% end %>
            <% if @show_top_machines_2 %><td style="color: #999;">-</td><% end %>
            <% if @show_top_machines_3 %><td style="color: #999;">-</td><% end %>
        </tr>
        <% end %>

        <!-- 各日のデータ -->
        <% @daily_summary.each do |summary| %>
        <% 
          wday = summary[:date].wday
          wday_names = ['日', '月', '火', '水', '木', '金', '土']
          wday_colors = ['#dc3545', '#333', '#333', '#333', '#333', '#333', '#007bff']
        %>
        <tr>
            <td>
                <%= link_to hall_machine_data_path(@hall, summary[:date]), class: "date-link" do %>
                <%= summary[:date].strftime('%Y/%m/%d') %>
                <span style="color: <%= wday_colors[wday] %>; font-weight: bold;">(<%= wday_names[wday] %>)</span>
                <% end %>
            </td>
            <td class="<%= summary[:total_diff] >= 0 ? 'positive' : 'negative' %>">
                <%= number_with_delimiter(summary[:total_diff]) %>
            </td>
            <td class="<%= summary[:avg_diff] >= 0 ? 'positive' : 'negative' %>">
                <%= number_with_delimiter(summary[:avg_diff]) %>
            </td>
            <td><%= number_with_delimiter(summary[:avg_games]) %></td>
            <td>
                <span class="<%= summary[:win_rate] >= 40 ? 'positive' : 'negative' %>">
                    <%= sprintf('%.1f', summary[:win_rate]) %>%
                </span>
                (<%= summary[:plus_machines] %>/<%= summary[:machine_count] %>)
            </td>
            <% if @show_top_machines_1 %>
            <td class="top-machine-cell">
                <% if summary[:top_machine_1] %>
                <div class="machine-name"><%= summary[:top_machine_1][:name] %></div>
                <div class="machine-diff <%= summary[:top_machine_1][:avg_diff] >= 0 ? 'positive' : 'negative' %>">
                    <%= number_with_delimiter(summary[:top_machine_1][:avg_diff]) %>
                </div>
                <% else %>
                -
                <% end %>
            </td>
            <% end %>
            <% if @show_top_machines_2 %>
            <td class="top-machine-cell">
                <% if summary[:top_machine_2] %>
                <div class="machine-name"><%= summary[:top_machine_2][:name] %></div>
                <div class="machine-diff <%= summary[:top_machine_2][:avg_diff] >= 0 ? 'positive' : 'negative' %>">
                    <%= number_with_delimiter(summary[:top_machine_2][:avg_diff]) %>
                </div>
                <% else %>
                -
                <% end %>
            </td>
            <% end %>
            <% if @show_top_machines_3 %>
            <td class="top-machine-cell">
                <% if summary[:top_machine_3] %>
                <div class="machine-name"><%= summary[:top_machine_3][:name] %></div>
                <div class="machine-diff <%= summary[:top_machine_3][:avg_diff] >= 0 ? 'positive' : 'negative' %>">
                    <%= number_with_delimiter(summary[:top_machine_3][:avg_diff]) %>
                </div>
                <% else %>
                -
                <% end %>
            </td>
            <% end %>
        </tr>
        <% end %>
    </tbody>
</table>
<% end %>