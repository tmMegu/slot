<link rel="stylesheet" href="/stylesheets/hall_map.css">
<link rel="stylesheet" href="/stylesheets/common.css">

<div class="container">
    <div class="flex-between mb-20">
        <%= link_to "← ホール一覧に戻る", halls_path, class: "btn btn-secondary btn-small" %>
        <h2 style="margin: 0; color: #10b981;"><%= @hall.name %> - マップ管理</h2>
        <%= link_to "+ 新規マップ作成", new_hall_map_path(@hall), class: "btn btn-success" %>
    </div>

    <% if @maps.any? %>
    <div class="maps-grid">
        <% @maps.each do |map| %>
        <div class="map-card">
            <div class="map-card-header">
                <div class="map-card-title">
                    <h3><%= map.name %></h3>
                    <span class="map-dimensions">📐 <%= map.rows %> × <%= map.cols %></span>
                </div>
            </div>

            <div class="map-card-body">
                <div class="map-stats">
                    <div class="stat-item">
                        <span class="stat-label">🎰 配置台数</span>
                        <span class="stat-value"><%= map.machine_numbers.count %> 台</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">📅 作成日</span>
                        <span class="stat-value"><%= map.created_at.strftime('%Y/%m/%d') %></span>
                    </div>
                </div>
            </div>

            <div class="map-card-actions">
                <%= link_to edit_hall_map_path(@hall, map), class: "btn-action btn-edit" do %>
                ✏️ 編集
                <% end %>
                <%= button_to duplicate_hall_map_path(@hall, map), method: :post, class: "btn-action btn-duplicate" do %>
                📋 複製
                <% end %>
                <%= button_to hall_map_path(@hall, map), method: :delete, 
                    data: { turbo_confirm: "「#{map.name}」を削除してもよろしいですか？" }, 
                    class: "btn-action btn-delete" do %>
                🗑️ 削除
                <% end %>
            </div>
        </div>
        <% end %>
    </div>
    <% else %>
    <div class="card" style="text-align: center; padding: 60px 20px;">
        <h2 style="color: #6c757d; margin-bottom: 20px;">📋 マップがまだ作成されていません</h2>
        <p style="color: #999; margin-bottom: 30px; font-size: 16px;">
            店内の配置図を作成すると、台の位置と実績を視覚的に確認できます。
        </p>
        <%= link_to "+ 最初のマップを作成", new_hall_map_path(@hall), class: "btn btn-success" %>
    </div>
    <% end %>
</div>