<link rel="stylesheet" href="/stylesheets/hall_map.css">

<div class="container">
    <div class="flex-between" style="margin-bottom: 20px;">
        <%= link_to "← マップ一覧", hall_maps_path(@hall), class: "btn btn-secondary" %>
        <h1 style="margin: 0;">✏️ マップ編集: <%= @map.name %></h1>
        <button onclick="saveMapData()" class="btn btn-success" id="save-btn">
            💾 保存
        </button>
    </div>

    <div class="card" style="padding: 0;">
        <div style="padding: 20px; background: #f9fafb; border-bottom: 1px solid #e5e7eb;">
            <div style="text-align: center;">
                <span style="font-weight: 600; color: #6b7280;">📐 <%= @map.rows %>行 × <%= @map.cols %>列</span>
            </div>
        </div>

        <!-- ツールパレット（画面上部） -->
        <div class="tool-palette-top">
            <div class="tool-buttons-horizontal">
                <button class="tool-btn active" data-tool="select" onclick="selectTool('select')">
                    👆 選択
                </button>
                <button class="tool-btn" data-tool="machine" onclick="selectTool('machine')">
                    🎰 台を配置
                </button>
                <button class="tool-btn" data-tool="wall" onclick="selectTool('wall')">
                    🧱 壁
                </button>
                <button class="tool-btn" data-tool="counter" onclick="selectTool('counter')">
                    🏪 カウンター
                </button>
                <button class="tool-btn" data-tool="empty" onclick="selectTool('empty')">
                    ⬜ 空白
                </button>
                <button class="tool-btn" data-tool="eraser" onclick="selectTool('eraser')">
                    🗑️ 消しゴム
                </button>
            </div>
        </div>

        <!-- 操作パネル -->
        <div class="editor-control-panel">
            <!-- 台番号入力 -->
            <div id="machine-input-panel" class="control-section">
                <label class="control-label">台番号:</label>
                <input type="number" id="machine-number-input" placeholder="例: 101" class="control-input" style="width: 100px;">
                <button onclick="applyMachineNumber()" class="btn btn-secondary btn-small">適用</button>
                <div style="display: inline-flex; gap: 8px; margin-left: 15px;">
                    <label class="radio-option">
                        <input type="radio" name="auto-increment" value="0" checked>
                        <span>増減なし</span>
                    </label>
                    <label class="radio-option">
                        <input type="radio" name="auto-increment" value="1">
                        <span>+1</span>
                    </label>
                    <label class="radio-option">
                        <input type="radio" name="auto-increment" value="-1">
                        <span>-1</span>
                    </label>
                </div>
            </div>

            <!-- 選択情報 -->
            <div class="control-section">
                <label class="control-label">選択中:</label>
                <span id="selection-display" style="color: #6b7280; font-size: 14px;">なし</span>
            </div>

            <!-- 行列編集 -->
            <div id="row-col-edit-panel" class="control-section">
                <label class="control-label">行列編集:</label>
                <button onclick="addRowAtSelection('above')" class="btn btn-secondary btn-small">↑ 行追加</button>
                <button onclick="addRowAtSelection('below')" class="btn btn-secondary btn-small">↓ 行追加</button>
                <button onclick="addColumnAtSelection('left')" class="btn btn-secondary btn-small">← 列追加</button>
                <button onclick="addColumnAtSelection('right')" class="btn btn-secondary btn-small">→ 列追加</button>
                <button onclick="removeRowAtSelection('current')" class="btn btn-danger btn-small">行削除</button>
                <button onclick="removeColumnAtSelection('current')" class="btn btn-danger btn-small">列削除</button>
            </div>

            <!-- ズーム操作 -->
            <div class="control-section">
                <label class="control-label" style="font-size: 12px;">ズーム:</label>
                <button onclick="zoomIn()" class="btn btn-secondary" style="padding: 4px 8px; font-size: 12px;">+</button>
                <button onclick="zoomOut()" class="btn btn-secondary" style="padding: 4px 8px; font-size: 12px;">-</button>
                <button onclick="resetZoom()" class="btn btn-secondary" style="padding: 4px 8px; font-size: 12px;">100%</button>
            </div>
        </div>

        <div class="map-editor-container" data-hall-id="<%= @hall.id %>" data-map-id="<%= @map.id %>" style="padding: 20px;">

            <!-- マップグリッド -->
            <div class="editor-grid-container">
                <div class="grid-scroll-area">
                    <table id="editor-map-table" class="editor-map-table">
                        <tbody>
                            <% (1..@map.rows).each do |row| %>
                            <tr>
                                <% (1..@map.cols).each do |col| %>
                                <%
                          cell = @map.get_cell(row, col)
                          machine_number = cell['machine_number']
                          cell_type = cell['type'] || 'empty'
                          label = cell['label']
                        %>
                                <td class="editor-cell <%= cell_type %>" data-row="<%= row %>" data-col="<%= col %>" data-type="<%= cell_type %>" data-machine-number="<%= machine_number %>" data-label="<%= label %>" onclick="selectCell(<%= row %>, <%= col %>)">

                                    <% if cell_type == 'machine' %>
                                    <div class="cell-content">
                                        <span class="cell-number"><%= machine_number %></span>
                                    </div>

                                    <% elsif cell_type == 'wall' %>
                                    <div class="cell-content wall">
                                        <%= label || '■' %>
                                    </div>

                                    <% elsif cell_type == 'counter' %>
                                    <div class="cell-content counter">
                                        <%= label || 'カウンター' %>
                                    </div>

                                    <% end %>
                                </td>
                                <% end %>
                            </tr>
                            <% end %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- フォーム（非表示） -->
<%= form_with url: hall_map_path(@hall, @map), method: :patch, id: "map-save-form", style: "display: none;" do |f| %>
<%= hidden_field_tag :layout_data, "", id: "layout-data-field" %>
<%= hidden_field_tag "hall_map[rows]", @map.rows, id: "rows-field" %>
<%= hidden_field_tag "hall_map[cols]", @map.cols, id: "cols-field" %>
<% end %>

<!-- データ保持用のhiddenフィールド -->
<div id="editor-initial-data" data-hall-id="<%= @hall.id %>" data-map-id="<%= @map.id %>" data-rows="<%= @map.rows %>" data-cols="<%= @map.cols %>" style="display: none;">
    <%= @map.safe_layout_data.to_json %>
</div>

<script src="/javascripts/hall_map_editor.js"></script>