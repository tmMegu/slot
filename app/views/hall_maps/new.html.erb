<link rel="stylesheet" href="/stylesheets/hall_map.css">

<div class="container">
    <div class="flex-between" style="margin-bottom: 20px;">
        <%= link_to "← マップ一覧", hall_maps_path(@hall), class: "btn btn-secondary btn-small" %>
        <h1 style="margin: 0;">🗺️ 新規マップ作成</h1>
        <div></div>
    </div>

    <div class="card">
        <p style="color: #6b7280; margin-bottom: 30px;">
            店内の配置図を作成します。まずはマップの基本情報を入力してください。
        </p>

        <%= form_with model: @map, url: hall_maps_path(@hall), local: true do |f| %>
        <div class="form-group">
            <%= f.label :name, "マップ名", class: "form-label" %>
            <%= f.text_field :name, class: "form-control", placeholder: "例: 1階フロア、2階フロア", required: true %>
            <small class="form-text">わかりやすい名前を付けてください</small>
        </div>

        <div class="form-row">
            <div class="form-group">
                <%= f.label :rows, "行数（縦）", class: "form-label" %>
                <%= f.number_field :rows, class: "form-control", min: 1, max: 100, value: @map.rows || 20, required: true %>
                <small class="form-text">1〜100</small>
            </div>

            <div class="form-group">
                <%= f.label :cols, "列数（横）", class: "form-label" %>
                <%= f.number_field :cols, class: "form-control", min: 1, max: 100, value: @map.cols || 40, required: true %>
                <small class="form-text">1〜100</small>
            </div>
        </div>

        <div class="form-preview">
            <h3>プレビュー</h3>
            <div id="grid-preview" style="overflow: auto; max-height: 400px;">
                <!-- JavaScript で動的に生成 -->
            </div>
            <p style="text-align: center; color: #6b7280; margin-top: 10px; font-size: 13px;">
                ※プレビューは最大20行×40列まで表示されます
            </p>
        </div>

        <div class="form-actions">
            <%= link_to "キャンセル", hall_maps_path(@hall), class: "btn btn-secondary" %>
            <%= f.submit "作成して編集画面へ", class: "btn btn-primary" %>
        </div>
        <% end %>
    </div>
</div>

<script src="/javascripts/hall_map_new.js"></script>