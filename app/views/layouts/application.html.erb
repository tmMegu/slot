<!DOCTYPE html>
<html lang="ja">

<head>
    <title><%= content_for(:title) || "Slot" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Slot">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="stylesheet" href="/stylesheets/common.css">
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
</head>

<body>
    <header class="app-header">
        <div class="app-header__inner">
            <%= link_to root_path, class: "app-header__brand" do %>
                <span class="app-header__brand-icon">🎰</span>
                <span class="app-header__brand-text">Slot</span>
            <% end %>

            <div class="app-header__title">
                <%= yield :header_title %>
            </div>

            <nav class="app-header__actions">
                <%= yield :header_actions %>
            </nav>
        </div>
    </header>

    <% if flash[:notice] %>
    <div class="container">
        <div class="alert alert-success"><%= flash[:notice] %></div>
    </div>
    <% end %>

    <% if flash[:alert] %>
    <div class="container">
        <div class="alert alert-danger"><%= flash[:alert] %></div>
    </div>
    <% end %>

    <main>
        <%= yield %>
    </main>
</body>

</html>
