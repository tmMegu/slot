<% content_for :header_title, "#{@hall.name} · 編集" %>
<% content_for :header_actions do %>
    <%= link_to "← 詳細", hall_path(@hall), class: "header-link" %>
    <%= link_to "ホール一覧", halls_path, class: "header-link" %>
<% end %>

<div class="container">
    <div class="card">
        <div class="card-header">ホール編集</div>
        <%= form_tag hall_path(@hall), method: :patch do %>
        <div class="form-group">
            <label class="form-label">ホール名</label>
            <input type="text" name="name" value="<%= @hall.name %>" class="form-control" required>
        </div>

        <div class="form-group">
            <label class="form-label">ホールコード</label>
            <input type="text" name="code" value="<%= @hall.code %>" class="form-control" required>
        </div>

        <div class="form-group">
            <label class="form-label">メモ</label>
            <textarea name="memo" class="form-control" placeholder="必要に応じてメモを入力してください"><%= @hall.memo %></textarea>
        </div>

        <div class="form-group">
            <label class="form-label">周年日（毎年の同日）</label>
            <input type="text" name="anniversary_month_day" value="<%= @hall.anniversary_month_day %>" class="form-control" placeholder="MM-DD 形式（例 07-15）" pattern="\d{2}-\d{2}">
            <small style="color:#6b7280; font-size:11px;">毎年同じ日に発生する周年日。年は無視されます。空欄でも構いません。</small>
        </div>

        <div class="form-group">
            <label class="form-label">グランドオープン日</label>
            <input type="date" name="grand_open_date" value="<%= @hall.grand_open_date %>" class="form-control">
            <small style="color:#6b7280; font-size:11px;">ホールが開店した特定の1日。MCP の周年効果分析で使用。</small>
        </div>

        <hr style="margin: 30px 0; border: none; border-top: 2px solid #10b981;">
        <h3 style="color: #333; margin-bottom: 20px;">📋 データ取込み先URL</h3>

        <% (1..5).each do |i| %>
        <div class="form-group">
            <label class="form-label">URL <%= i %></label>
            <input type="url" name="data_import_url<%= i %>" class="form-control" placeholder="https://example.com/data" value="<%= @hall.send("data_import_url#{i}".to_sym) %>" style="font-size: 13px;">
        </div>
        <% end %>

        <div class="btn-group">
            <button type="submit" class="btn btn-primary">更新</button>
            <%= link_to "キャンセル", halls_path, class: "btn btn-secondary" %>
        </div>
        <% end %>
    </div>
</div>